---
import { nav } from '../content/en/nav';
import { appStoreUrl } from '../lib/app-store';
import Button from './Button.astro';
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__home">
      <Logo class="site-header__logo" height={28} />
    </a>
    <nav aria-label={nav.label} class="site-header__nav">
      <ul class="site-header__links">
        {nav.links.map((link) => (
          <li>
            <a href={link.href} class="site-header__link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={appStoreUrl('nav')} variant="secondary" size="sm" class="site-header__cta">
        {nav.getTheApp}
      </Button>
    </nav>
  </div>
</header>

<style>
  /* Sits over the hero, whose glows and waves start at the top of the page */
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  /*
   * A wider column than the content (Figma: 80 px margins at 1440, 1280 max),
   * never closer to the edge than the phone and tablet gutters.
   */
  .site-header__inner {
    --header-gutter: min(var(--gutter), 3rem);

    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: calc(80rem + 2 * var(--header-gutter));
    margin-inline: auto;
    padding: 1rem var(--header-gutter) 0; /* centers the row at Figma 38 */
  }

  .site-header__home {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    border-radius: var(--radius-sm);
  }

  .site-header__logo {
    width: auto;
    height: 1.375rem; /* 22 */
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-header__links {
    display: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--color-ink-secondary);
    font-size: 0.9375rem; /* 15 */
    line-height: 1.2;
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-out);
  }

  /* Phone: a smaller pill (Figma 36 px, 14 px text); the hit area stays 44 px */
  .site-header__cta {
    --button-size: 2.25rem;

    padding-inline: 1rem;
    font-size: var(--text-sm);
  }

  @media (width >= 768px) {
    .site-header__inner {
      padding-top: 1.75rem; /* centers the row at Figma 50 */
    }

    .site-header__logo {
      height: 1.75rem; /* 28 */
    }

    .site-header__links {
      display: flex;
    }

    .site-header__cta {
      --button-size: 40px;

      padding-inline: 1.75rem;
      font-size: var(--text-md);
    }
  }

  @media (width >= 1280px) {
    .site-header__nav,
    .site-header__links {
      gap: 2.25rem; /* 36 */
    }
  }

  @media (hover: hover) {
    .site-header__link:hover {
      color: var(--color-ink);
    }
  }
</style>
