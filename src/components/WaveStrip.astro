---
import { wavePresets, type WavePresetId } from '../data/presets/waves';
import {
  GLOW_LAYERS,
  STRIP_CYCLES,
  STRIP_OFFSET,
  waveStrokes,
  type WaveTint,
} from '../lib/wave/geometry';
import { uniqueId } from '../lib/unique-id';

interface Props {
  preset: WavePresetId;
  /** strip: full-width background (Figma strip rule). box: fills its container. */
  layout?: 'strip' | 'box';
  /** Height in px. */
  height: number;
  class?: string;
}

const { preset, layout = 'box', height, class: className } = Astro.props;

const params = wavePresets[preset];
const isStrip = layout === 'strip';
/*
 * Box: the SVG fills the box and stretches sideways only. Strip: the SVG is
 * sized in CSS (crest length and amplitude per width) and only scales, so every
 * crest stays an even sine.
 */
const viewWidth = isStrip ? STRIP_CYCLES * 100 : 1000;
const viewHeight = isStrip ? params.refHeight : height;
const strokes = waveStrokes(params, {
  width: viewWidth,
  height: viewHeight,
  t: 0,
  energy: 1,
  amplitudeScale: isStrip ? 1 : height / params.refHeight,
});
const id = uniqueId('wave');
const color = (tint: WaveTint) => `var(--color-${tint})`;
const glowLayers = params.glow ? GLOW_LAYERS : [];
const viewBox = `0 0 ${viewWidth} ${viewHeight}`;
const stripVars = isStrip
  ? `; --strip-cycles: ${STRIP_CYCLES}; --strip-offset: ${STRIP_OFFSET}; --strip-box: ${params.refHeight / params.amplitude}`
  : '';
---

<div
  class:list={['wave', isStrip && 'wave--strip', className]}
  data-wave={preset}
  style={`--wave-height: ${height}px${stripVars}`}
  aria-hidden="true"
>
  {
    /*
     * Each glow layer is its own <svg>, blurred through CSS `filter: url()`. On an
     * HTML-level element the blur is measured in CSS px, so it stays round even
     * though the viewBox is stretched sideways. The filter region reaches well
     * past the box, so the blur never ends in a straight edge.
     */
    glowLayers.map((layer) => (
      <svg
        viewBox={viewBox}
        preserveAspectRatio="none"
        focusable="false"
        style={`filter: url(#${id}-${layer.name}); opacity: ${layer.opacity}`}
      >
        {strokes.map((stroke, k) => (
          <use
            href={`#${id}-${k}`}
            style={`stroke: ${color(stroke.tint)}; stroke-width: ${stroke.width}; stroke-opacity: ${stroke.alpha}`}
          />
        ))}
      </svg>
    ))
  }
  <svg viewBox={viewBox} preserveAspectRatio="none" focusable="false">
    <defs>
      {strokes.map((stroke, k) => (
        <path
          id={`${id}-${k}`}
          d={stroke.d}
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      ))}
      {glowLayers.map((layer) => (
        <filter
          id={`${id}-${layer.name}`}
          x="-25%"
          y="-100%"
          width="150%"
          height="300%"
          color-interpolation-filters="sRGB"
        >
          <feGaussianBlur stdDeviation={layer.blurRadius / 2} />
        </filter>
      ))}
    </defs>
    {strokes.map((stroke, k) => (
      <use
        href={`#${id}-${k}`}
        style={`stroke: ${color(stroke.tint)}; stroke-width: ${stroke.width}; stroke-opacity: ${stroke.alpha}`}
      />
    ))}
  </svg>
</div>

<style>
  .wave {
    position: relative;
    width: 100%;
    height: var(--wave-height);
    pointer-events: none;
  }

  /* Out of flow, so the 1000-unit viewBox never asks its container for width */
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }

  /*
   * Background strips (Figma 214:574, phone redrawn in 201:3): about 2.6 crests
   * on a 393 phone with a 16 px center amplitude, 3.2 crests and 3% of the
   * width from 1024 up (1024: 320 / 30.7, 1440: 450 / 43.2). One linear
   * segment between, so nothing jumps.
   */
  .wave--strip {
    --strip-wavelength: calc(26.7585vw + 2.8746rem);
    --strip-amplitude: calc(2.3328vw + 0.427rem);

    overflow-x: clip;
  }

  @media (width >= 1024px) {
    .wave--strip {
      --strip-wavelength: 31.25vw;
      --strip-amplitude: 3vw;
    }
  }

  .wave--strip svg {
    inset: 50% auto auto calc(-100% * var(--strip-offset));
    width: calc(var(--strip-cycles) * var(--strip-wavelength));
    height: calc(var(--strip-box) * var(--strip-amplitude));
    translate: 0 -50%;
  }
</style>
