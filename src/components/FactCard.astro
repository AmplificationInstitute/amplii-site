---
import GlassCard from './GlassCard.astro';

interface Props {
  /** Large number from tablet up, e.g. "01". */
  number: string;
  title: string;
  body: string;
}

const { number, title, body } = Astro.props;
---

<GlassCard as="li" class="fact-card">
  <p class="fact-card__number" aria-hidden="true">
    {number}
  </p>
  <h3 class="fact-card__title">{title}</h3>
  <p class="fact-card__body">{body}</p>
</GlassCard>

<style>
  /*
   * Phone (Figma 206:14, without the "1 of 4" label): 280 wide, padding 22,
   * radius 26, as tall as the longest card in the row. From 768 (218:1553,
   * 213:46): padding 28, radius 30, the number in Jost Light above the title,
   * 220 tall (280 from 1280). Padding is inside the 1 px border. Selectors carry
   * .card so they outrank GlassCard's own.
   */
  .fact-card.card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.3125rem;
    border-radius: 1.625rem;
  }

  .fact-card__number {
    display: none;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--weight-light);
    line-height: 1;
  }

  .fact-card__title {
    font-family: var(--font-text);
    font-size: 1.1875rem;
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .fact-card__body {
    color: var(--color-ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @media (width >= 768px) {
    .fact-card.card {
      gap: 0.75rem;
      min-height: 13.75rem;
      padding: 1.6875rem;
      border-radius: var(--radius-card);
    }

    .fact-card__number {
      display: block;
    }

    .fact-card__title {
      font-size: var(--text-lg);
    }
  }

  @media (width >= 1280px) {
    .fact-card.card {
      min-height: 17.5rem;
    }
  }
</style>
