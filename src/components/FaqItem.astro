---
interface Props {
  question: string;
  answer: string;
  /** Shared `name`: the browser keeps one answer open at a time. */
  group: string;
  open?: boolean;
}

const { question, answer, group, open = false } = Astro.props;
---

<details class="faq-item" name={group} open={open} data-part="faq-item">
  <summary class="faq-item__question">
    <span>{question}</span>
    <svg class="faq-item__icon" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M3.375 9H14.625" />
      <path class="faq-item__icon-vertical" d="M9 3.375V14.625" />
    </svg>
  </summary>
  <p class="faq-item__answer">{answer}</p>
</details>

<style>
  /*
   * Phone (Figma 202:84): 18 px above and below, 16 px questions, 15 px
   * answers 8 px under the question, 16 px icon. From 768 (231:282, 213:142):
   * 22 px, 18 px questions, 16 px answers 10 px under, 18 px icon. The
   * padding sits on the summary, so the whole row is the tap target.
   */
  .faq-item {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1.125rem;
    font-size: 1rem;
    font-weight: var(--weight-medium);
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question span {
    flex: 1;
  }

  .faq-item__icon {
    flex: none;
    width: 1rem;
    height: 1rem;
    stroke: var(--color-accent);
    stroke-width: 1.4625;
    stroke-linecap: round;
  }

  /* Plus when closed, minus when open */
  .faq-item[open] .faq-item__icon-vertical {
    display: none;
  }

  .faq-item__answer {
    margin-top: -0.625rem; /* 8 below the question */
    padding-bottom: 1.125rem;
    color: var(--color-ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @media (width >= 768px) {
    .faq-item__question {
      padding-block: 1.375rem;
      font-size: 1.125rem;
    }

    .faq-item__icon {
      width: 1.125rem;
      height: 1.125rem;
    }

    .faq-item__answer {
      margin-top: -0.75rem; /* 10 below the question */
      padding-bottom: 1.375rem;
      font-size: 1rem;
    }
  }
</style>
