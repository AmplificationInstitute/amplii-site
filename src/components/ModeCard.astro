---
import { modesCopy } from '../content/en/modes';
import { modes, type ModeId } from '../data/presets/modes';
import GlassCard from './GlassCard.astro';
import WaveStrip from './WaveStrip.astro';

interface Props {
  mode: ModeId;
}

const { mode: modeId } = Astro.props;
const mode = modes.find((m) => m.id === modeId) ?? modes[0];
---

<GlassCard as="li" class="mode-card">
  <div class="mode-card__wave">
    <WaveStrip preset={mode.id} height={64} class="mode-card__strip" />
  </div>
  <div class="mode-card__text">
    <p class="mode-card__band">{modesCopy.bandHz(mode.band, mode.arcHz.hold)}</p>
    <h3 class="mode-card__name">{mode.name}</h3>
    <p class="mode-card__description">{modesCopy.descriptions[mode.id]}</p>
    <p class="mode-card__length">{modesCopy.defaultLength(mode.defaultMinutes)}</p>
  </div>
</GlassCard>

<style>
  /*
   * Phone (Figma 201:151): a row in the light glass, radius 22, 64 x 40 wave
   * beside the text. From 768 (218:1480, 211:170): the card glass, the 64 px
   * wave above the text. Selectors carry .card so they outrank GlassCard's own.
   */
  .mode-card.card {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: center;
    column-gap: 1rem;
    padding: 0.75rem 1rem 0.75rem 0.8125rem;
    border-color: var(--glass-stroke-soft);
    border-radius: 1.375rem;
    background: var(--glass-fill);
    box-shadow: none;
  }

  .mode-card .mode-card__wave .mode-card__strip {
    height: 2.5rem;
  }

  .mode-card__text {
    display: grid;
    gap: 0.25rem;
  }

  .mode-card__band {
    color: var(--color-accent);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .mode-card__name {
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: var(--weight-medium);
    line-height: 1.2;
  }

  .mode-card__description,
  .mode-card__length {
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .mode-card__length {
    font-size: 0.75rem;
  }

  @media (width >= 768px) {
    .mode-card.card {
      display: block;
      padding: 1.75rem;
      border-color: var(--card-stroke);
      border-radius: var(--radius-card);
      background: var(--card-fill);
      box-shadow: var(--card-shadow);
    }

    /* Figma "Mini wave": 102 x 64, then an 8 px spacer */
    .mode-card__wave {
      width: 6.4rem;
      margin-bottom: 1.5rem;
    }

    .mode-card .mode-card__wave .mode-card__strip {
      height: 4rem;
    }

    .mode-card__text {
      gap: 0.5rem;
    }

    .mode-card__band {
      font-size: 0.8125rem;
    }

    .mode-card__name {
      font-size: var(--text-lg);
      line-height: 1.25;
    }

    .mode-card__description {
      color: var(--color-ink-secondary);
      font-size: 0.9375rem;
      line-height: 1.4;
    }

    .mode-card__length {
      font-size: 0.8125rem;
    }
  }
</style>
