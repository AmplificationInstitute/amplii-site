---
import { pricing } from '../content/en/pricing';
import { appStoreUrl } from '../lib/app-store';
import Button from './Button.astro';
import GlassCard from './GlassCard.astro';
import Pill from './Pill.astro';

interface Props {
  plan: 'free' | 'full';
}

const { plan } = Astro.props;
const { full, free } = pricing;
---

{plan === 'full' ? (
  <GlassCard as="article" class="plan-card plan-card--full">
    <div class="plan-card__head">
      <h3 class="plan-card__name">{full.name}</h3>
      <Pill label={full.pill} class="plan-card__pill" />
    </div>
    <p class="plan-card__tagline">{full.tagline}</p>
    <span class="plan-card__divider" aria-hidden="true" />
    <ul class="plan-card__features">
      {full.features.map((feature) => (
        <li class="plan-card__feature">
          <p class="plan-card__feature-title">{feature.title}</p>
          <p class="plan-card__feature-body">{feature.body}</p>
        </li>
      ))}
    </ul>
    <span class="plan-card__divider" aria-hidden="true" />
    <Button href={appStoreUrl('pricing-full')} class="plan-card__cta">
      {full.cta}
    </Button>
    <p class="plan-card__note">{full.note}</p>
  </GlassCard>
) : (
  <GlassCard as="article" class="plan-card plan-card--free">
    <h3 class="plan-card__name">{free.name}</h3>
    <p class="plan-card__tagline">{free.tagline}</p>
    <span class="plan-card__divider" aria-hidden="true" />
    <ul class="plan-card__items">
      {free.items.map((item) => (
        <li class="plan-card__item">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path
              d="M4 9.5L7.2 12.5L14 5.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {item}
        </li>
      ))}
    </ul>
    <Button href={appStoreUrl('pricing-free')} class="plan-card__cta">
      {free.cta}
    </Button>
  </GlassCard>
)}

<style>
  /*
   * Phone (Figma 206:49): padding 24, radius 30, features stacked between
   * dividers, a full-width 52 px button. Free has the same layout and button
   * as Full (Ana: both plans get the same button, and Free shows its list on
   * phone too), in the lighter glass. From 768 (217:320, 217:386): padding
   * 44, radius 40, the features in three columns. Padding is
   * inside the 1 px border. Names are Jost Regular (CLAUDE.md overrides the
   * Figma SemiBold). Selectors carry .card so they outrank GlassCard's own.
   */
  .plan-card.card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .plan-card > * {
    max-width: 100%;
  }

  .plan-card--full.card,
  .plan-card--free.card {
    gap: 0.875rem;
    padding: 1.4375rem;
  }

  .plan-card--full.card {
    border-color: var(--card-stroke-strong);
  }

  .plan-card--free.card {
    border-color: var(--glass-stroke);
    background: var(--glass-fill);
    box-shadow: none;
  }

  .plan-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .plan-card__name {
    font-family: var(--font-display);
    font-size: 1.75rem; /* 28 */
    font-weight: var(--weight-title);
    line-height: 1.1;
  }

  .plan-card .plan-card__pill.pill {
    flex: none;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }

  .plan-card__tagline {
    color: var(--color-ink-secondary);
    font-size: 1rem;
    line-height: 1.4;
  }

  .plan-card__divider {
    display: block;
    align-self: stretch;
    height: 1px;
    background: rgb(255 255 255 / 14%);
  }

  /* Phone: one feature per row, a divider between each */
  .plan-card__features {
    display: grid;
    gap: 0.875rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-card__feature {
    display: grid;
    align-content: start;
    gap: 0.125rem;
  }

  .plan-card__feature + .plan-card__feature {
    padding-top: 0.875rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .plan-card__feature-title {
    font-size: 1rem;
    font-weight: var(--weight-medium);
    line-height: 1.3;
  }

  .plan-card__feature-body {
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  /* Ana: more room above the buttons (24 on phone, 32 from 768) */
  .plan-card .plan-card__cta.button {
    --button-size: 52px;

    align-self: stretch;
    margin-top: 0.625rem;
    font-size: 0.9375rem;
  }

  /* The trial terms, small, under the Full button */
  .plan-card__note {
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .plan-card__items {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan-card__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .plan-card__item svg {
    flex: none;
    color: var(--color-accent);
  }

  @media (width >= 768px) {
    .plan-card--full.card,
    .plan-card--free.card {
      gap: 1.25rem;
      padding: 2.6875rem;
      border-radius: 2.5rem;
    }

    .plan-card__name {
      font-family: var(--font-display);
      font-size: 2.5rem; /* 40 */
      font-weight: var(--weight-title);
      line-height: 1.1;
    }

    .plan-card .plan-card__pill.pill {
      padding: 0.4375rem 0.875rem;
      font-size: var(--text-sm);
    }

    .plan-card__tagline {
      font-size: 1.125rem;
    }

    .plan-card--free .plan-card__divider {
      background: rgb(255 255 255 / 12%);
    }

    /* Three features side by side, no dividers between them */
    .plan-card__features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }

    .plan-card__feature {
      gap: 0.375rem;
    }

    .plan-card__feature + .plan-card__feature {
      padding-top: 0;
      border-top: 0;
    }

    .plan-card__feature-title {
      font-size: var(--text-md);
      line-height: 1.25;
    }

    .plan-card__feature-body {
      font-size: 0.9375rem;
    }

    .plan-card__note {
      margin-top: -0.375rem; /* 14 below the button */
      font-size: var(--text-sm);
    }

    .plan-card .plan-card__cta.button {
      --button-size: var(--button-height);

      align-self: flex-start;
      margin-top: 0.75rem;
      font-size: var(--text-md);
    }

    .plan-card__items {
      gap: 1.25rem;
    }

    .plan-card__item {
      font-size: 1rem;
    }
  }
</style>
