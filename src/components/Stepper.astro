---
interface Props {
  steps: readonly string[];
  /** 1-based step shown as current; 0 for none. */
  current: number;
  /** Accessible name of the list. */
  label: string;
  class?: string;
}

const { steps, current, label, class: className } = Astro.props;
---

<ol class:list={['stepper', className]} aria-label={label} data-part="stepper">
  {steps.map((step, index) => (
    <li class="stepper__step" aria-current={index + 1 === current ? 'step' : undefined}>
      <span class="stepper__number" aria-hidden="true">
        {index + 1}
      </span>
      {step}
    </li>
  ))}
</ol>

<style>
  .stepper {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stepper__step {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.625rem;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.2;
  }

  .stepper__number {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: var(--radius-capsule);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
  }

  .stepper__step[aria-current] {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }

  .stepper__step[aria-current] .stepper__number {
    border-color: transparent;
    background: var(--color-ink);
    color: var(--color-on-accent);
  }
</style>
