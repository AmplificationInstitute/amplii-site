---
import AppStoreBadge from '../components/AppStoreBadge.astro';
import Button from '../components/Button.astro';
import GlassCard from '../components/GlassCard.astro';
import Glow from '../components/Glow.astro';
import Logo from '../components/Logo.astro';
import Pill from '../components/Pill.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WaveStrip from '../components/WaveStrip.astro';
import { home } from '../content/en/home';
import { showcase } from '../content/en/showcase';
import { modes } from '../data/presets/modes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appStoreUrl } from '../lib/app-store';
---

<!-- Phase 2a component sheet. 2b replaces this page with the real sections. -->
<BaseLayout path="/">
  <Section name="hero" labelledBy="sheet-title" class="sheet-hero">
    <Fragment slot="bleed">
      <Glow x="30%" y="20%" width="760px" height="520px" />
      <Glow x="70%" y="60%" width="760px" height="520px" />
      <WaveStrip preset="background" layout="strip" height={340} class="sheet-strip" />
    </Fragment>
    <div class="sheet-stack">
      <Logo />
      <h1 id="sheet-title" class="sheet-h1">
        {home.headline}
      </h1>
      <div class="sheet-row">
        <AppStoreBadge campaign="hero" eager />
        <Button href="#waves" variant="secondary">
          {showcase.buttons.secondary}
        </Button>
      </div>
    </div>
  </Section>

  <Section name="sheet" id="waves" labelledBy="sheet-section">
    <div class="sheet-stack">
      <SectionHeader id="sheet-section" title={showcase.sectionTitle} lead={showcase.sectionLead} />
      <div class="sheet-row">
        <Button>{showcase.buttons.primary}</Button>
        <Button size="md" variant="secondary">
          {showcase.buttons.secondary}
        </Button>
        <Button size="sm" variant="secondary" href={appStoreUrl('nav')}>
          {showcase.buttons.nav}
        </Button>
        <Pill label={showcase.pill} />
      </div>

      <ul class="sheet-grid sheet-wide">
        {modes.map((mode) => (
          <GlassCard as="li">
            <WaveStrip preset={mode.id} height={64} />
            <p class="sheet-meta">
              {mode.band} · {mode.arcHz.hold} Hz
            </p>
            <h3 class="sheet-card-title">{mode.name}</h3>
            <p class="sheet-meta">{showcase.defaultLength(mode.defaultMinutes)}</p>
          </GlassCard>
        ))}
      </ul>

      <GlassCard padding="lg" class="sheet-wide">
        <h3 class="sheet-card-title">{showcase.demoLabel}</h3>
        <div class="sheet-demo">
          <WaveStrip preset="demo-left" height={200} />
          <WaveStrip preset="demo-right" height={200} />
          <WaveStrip preset="demo-beat" height={200} />
        </div>
        <p class="sheet-meta">{showcase.cardBody}</p>
      </GlassCard>
    </div>
  </Section>
</BaseLayout>

<style>
  .sheet-hero {
    min-height: 100dvh;
    display: grid;
    align-items: center;
  }

  .sheet-strip {
    position: absolute;
    bottom: 0;
  }

  .sheet-stack {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .sheet-stack > .sheet-wide {
    justify-self: stretch;
  }

  .sheet-h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-display);
  }

  .sheet-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .sheet-grid {
    display: grid;
    gap: var(--space-5);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 768px) {
    .sheet-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 1280px) {
    .sheet-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sheet-card-title {
    margin-block: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }

  .sheet-meta {
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
  }

  .sheet-demo {
    display: grid;
    margin-block: var(--space-5);
  }

  .sheet-demo > :global(*) {
    grid-area: 1 / 1;
  }
</style>
