---
import DemoCard from '../components/DemoCard.astro';
import Glow from '../components/Glow.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stepper from '../components/Stepper.astro';
import { tryTheBeat } from '../content/en/try-the-beat';
import { DEMO_START_MODE, demoTones } from '../data/presets/demo';

const tones = demoTones(DEMO_START_MODE);
---

<Section name="try-the-beat" id="how-it-works" labelledBy="try-title" class="try">
  <Fragment slot="bleed">
    <Glow
      class="try__ambient"
      tint="ambient"
      intensity={0.28}
      x="45.8%"
      y="20.625rem"
      width="32.5rem"
      height="26.25rem"
    />
    <Glow
      class="try__glow"
      intensity={0.3}
      x="var(--try-glow-a-x)"
      y="var(--try-glow-a-y)"
      width="var(--try-glow-a-w)"
      height="var(--try-glow-a-h)"
    />
    <Glow
      class="try__glow"
      intensity={0.24}
      x="var(--try-glow-b-x)"
      y="var(--try-glow-b-y)"
      width="var(--try-glow-b-w)"
      height="var(--try-glow-b-h)"
    />
  </Fragment>

  <div class="try__layout">
    <div class="try__intro">
      <SectionHeader id="try-title" title={tryTheBeat.title} lead={tryTheBeat.lead} />
      <Stepper
        steps={tryTheBeat.steps}
        current={1}
        label={tryTheBeat.stepsLabel}
        class="try__stepper"
      />
    </div>
    <DemoCard leftHz={tones.left} rightHz={tones.right} class="try__demo" />
    <p class="try__note" data-reveal>
      {tryTheBeat.note}
    </p>
  </div>
</Section>

<style>
  /*
   * Glows from the Figma frames (1024 / 1440), one linear segment between;
   * from 1440 they scale with the width.
   */
  .try {
    --lead-measure: 27.5rem; /* 440 */
    --try-glow-a-x: 71.79%;
    --try-glow-a-y: 21rem;
    --try-glow-a-w: 35rem;
    --try-glow-a-h: 28rem;
    --try-glow-b-x: 89.93%;
    --try-glow-b-y: 36rem;
    --try-glow-b-w: 28rem;
    --try-glow-b-h: 23rem;
  }

  @media (width >= 1024px) {
    .try {
      --try-glow-a-x: clamp(45.9438rem, 6.7284rem + 61.274vw, 61.875rem); /* 735 to 990 */
      --try-glow-a-y: clamp(20rem, 23.4615rem - 3.8462vw, 21rem); /* 336 to 320 */
      --try-glow-a-w: clamp(35rem, 13.4615rem + 33.6538vw, 43.75rem); /* 560 to 700 */
      --try-glow-a-h: clamp(28rem, 10.7692rem + 26.9231vw, 35rem); /* 448 to 560 */
      --try-glow-b-x: clamp(57.5562rem, 5.387rem + 81.5144vw, 78.75rem); /* 921 to 1260 */
      --try-glow-b-y: clamp(34.375rem, 40rem - 6.25vw, 36rem); /* 576 to 550 */
      --try-glow-b-w: clamp(28rem, 10.7692rem + 26.9231vw, 35rem); /* 448 to 560 */
      --try-glow-b-h: clamp(23rem, 8.8462rem + 22.1154vw, 28.75rem); /* 368 to 460 */
    }
  }

  @media (width >= 1440px) {
    .try {
      --try-glow-a-x: 68.75%;
      --try-glow-a-y: 22.2222vw;
      --try-glow-a-w: 48.6111vw;
      --try-glow-a-h: 38.8889vw;
      --try-glow-b-x: 87.5%;
      --try-glow-b-y: 38.1944vw;
      --try-glow-b-w: 38.8889vw;
      --try-glow-b-h: 31.9444vw;
    }
  }

  .try :global(.try__glow) {
    display: none;
  }

  @media (width >= 768px) {
    .try :global(.try__ambient) {
      display: none;
    }

    .try :global(.try__glow) {
      display: block;
    }
  }

  /*
   * Phone: title, lead, card, note (Figma 201:53). Tablet: the same, with the
   * steps between the lead and the card. From 1024: text and steps on the
   * left, the card on the right (218:1374, 211:57).
   */
  .try__layout {
    display: grid;
    gap: 1rem;
  }

  .try__intro {
    display: grid;
    gap: 2.375rem;
    margin-bottom: 1.25rem;
  }

  .try :global(.try__stepper) {
    display: none;
  }

  .try__note {
    max-width: 25rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (width >= 768px) {
    .try :global(.try__stepper) {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1.5rem;
    }

    .try__note {
      font-size: 0.8125rem;
    }
  }

  @media (width >= 1024px) {
    .try__layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 4fr);
      grid-template-areas:
        'intro demo'
        'note demo';
      align-items: start;
      column-gap: clamp(0.75rem, 16.3462vw - 9.7115rem, 5rem); /* 12 to 80 */
      row-gap: 2.25rem;
    }

    .try__intro {
      grid-area: intro;
      margin-bottom: 0;
    }

    .try :global(.try__stepper) {
      display: grid;
    }

    .try :global(.try__demo) {
      grid-area: demo;
    }

    .try__note {
      grid-area: note;
    }
  }
</style>
